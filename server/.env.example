# Bot WhatsApp CafeSite - salin ke .env.local lalu isi. JANGAN commit .env.local.
# Seluruh data memakai SQLite; tidak ada koneksi ke Supabase.

# --- Wajib ---
# Token API kontrol; HARUS sama dengan WA_BOT_CONTROL_TOKEN di .env.local Next.js (min. 16 karakter).
# Buat: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BOT_CONTROL_TOKEN=GANTI_DENGAN_TOKEN_RANDOM_PANJANG
BOT_CONTROL_HOST=127.0.0.1
BOT_CONTROL_PORT=8787

# --- Database & sesi ---
# File SQLite yang sama dengan website (default: ../.data/cafesite.dev.db)
DB_PATH=../.data/cafesite.dev.db
WA_SESSION_ID=cafesite
WA_SESSION_DIR=./session
# Opsional, hanya untuk tampilan di dashboard (format internasional tanpa +). Pairing lewat QR di dashboard.
WA_BOT_PHONE=

# Path Chrome/Chromium. Kosongkan untuk memakai Chromium bawaan Puppeteer.
# Windows: C:Program FilesGoogleChromeApplicationchrome.exe   Linux: /usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=

# --- Opsional: jawaban AI (tanpa ini bot tetap menjawab dari menu dan dokumen) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Opsional: pencarian dokumen berbasis makna (tanpa ini memakai kata kunci) ---
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1/embeddings
# Interval worker dokumen (ms, min. 1000)
RAG_POLL_MS=3000

# --- Anti-spam & sesi percakapan ---
RATE_LIMIT_MAX_PER_MINUTE=5
RATE_LIMIT_WINDOW_MS=60000
BOT_IDLE_MINUTES=10
BOT_REMINDER_MINUTES=8
LOG_LEVEL=info
