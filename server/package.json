{
  "name": "cafesite-wa-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot WhatsApp CafeSite (OpenWA + SQLite) - service Node.js terpisah dari Next.js, dikendalikan lewat dashboard.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "rag:ingest": "tsx src/rag/ingest.ts",
    "dev:watch": "tsx watch src/index.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pdf-parse": "^2.4.5",
    "@open-wa/wa-automate": "^5.1.0",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.5"
  }
}
