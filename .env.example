# Mode data: sqlite (default, tanpa Supabase). Satu-satunya mode yang dipakai bot dan dashboard.
CONTENT_SOURCE=sqlite

# Akun dashboard TIDAK disimpan di .env. Semua akun ada di database (SQLite + Supabase).
# Buat admin pertama dengan:  npm run admin:create -- --email admin@kedai.id --name "Nama"
# Atau salin akun dari Supabase ke SQLite:  npm run admin:create -- --pull

# Server bot WhatsApp (folder server/). Dibaca server Next.js saja, tidak pernah sampai ke browser.
# WA_BOT_CONTROL_TOKEN harus sama persis dengan BOT_CONTROL_TOKEN di server/.env.local.
WA_BOT_CONTROL_URL=http://127.0.0.1:8787
WA_BOT_CONTROL_TOKEN=GANTI_DENGAN_TOKEN_SAMA_DI_SERVER

# Hanya bila suatu hari kembali ke Supabase (CONTENT_SOURCE=supabase dan NEXT_PUBLIC_DATA_SOURCE=supabase):
# NEXT_PUBLIC_DATA_SOURCE=supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Alamat yang ditulis di QR meja (harus bisa dibuka dari HP pelanggan).
# Produksi: domain website, mis. https://cafesite.id  |  Uji di Wi-Fi yang sama: http://<IP-laptop>:3000
# Kosong = alamat dashboard yang sedang dibuka (jangan cetak QR dari http://localhost).
NEXT_PUBLIC_ORDER_BASE_URL=

# Wajib di Vercel: secret server yang stabil (minimal 16 karakter, disarankan 32 byte acak).
# Buat sendiri; jangan gunakan prefiks NEXT_PUBLIC_, jangan commit nilainya.
# Mengubah secret membuat QR dan token pesanan sebelumnya tidak berlaku.
# Setelah mengatur secret produksi, redeploy lalu buat ulang QR meja dari dashboard.
ORDER_ACCESS_SECRET=
